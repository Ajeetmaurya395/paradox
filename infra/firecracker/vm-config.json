{
  "boot-source": {
    "kernel_image_path": "/opt/paradox/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off init=/usr/bin/paradox-scanner"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/opt/paradox/scanner-rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 256,
    "track_dirty_pages": false
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "AA:FC:00:00:00:01",
      "host_dev_name": "tap0"
    }
  ],
  "logger": {
    "log_path": "/tmp/paradox/firecracker.log",
    "level": "Warning"
  },
  "metrics": {
    "metrics_path": "/tmp/paradox/firecracker-metrics"
  }
}
